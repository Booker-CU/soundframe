{
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/player",
      "destination": "/player.html"
    },
    {
      "source": "/player/:trackId",
      "destination": "/player.html"
    }
  ]
}
