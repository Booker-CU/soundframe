{
  "buildCommand": "npm run build",
  "framework": null,
  "headers": [
    {
      "source": "/frame-embed.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/player",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/farcaster.json",
      "destination": "/api/.well-known/farcaster.json"
    },
    {
      "source": "/embed-card",
      "destination": "/api/embed-card"
    },
    {
      "source": "/frame",
      "destination": "/api/frame"
    },
    {
      "source": "/frame/:path*",
      "destination": "/api/frame/:path*"
    },
    {
      "source": "/player",
      "destination": "/api/player"
    },
    {
      "source": "/player/:trackId",
      "destination": "/api/player/:trackId"
    }
  ]
}
