{
  "buildCommand": "npm run build",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/player",
      "destination": "/player.html"
    },
    {
      "source": "/player/:trackId",
      "destination": "/player.html"
    }
  ]
}
